# Local preview: true. VPS setup: change to false and set bootstrap admin below.
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000
OPS_DB_PATH=./ops.sqlite3
# Optional private storage for profile photos and KTP (default: beside the database).
# PROFILE_STORAGE_DIR=./private-profile-uploads
COOKIE_SECURE=0

# Set on a fresh VPS database with DEMO_MODE=false, then remove the password after first startup.
BOOTSTRAP_ADMIN_NAME=Capture It Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.id
BOOTSTRAP_ADMIN_PASSWORD=

# Google Calendar API (read-only OAuth credentials).
# Required scope: https://www.googleapis.com/auth/calendar.events.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Automatic Calendar sync interval in hours. 0 disables auto-sync.
GOOGLE_SYNC_INTERVAL_HOURS=24
# Push notifications (optional; HTTPS and a Firebase project are required).
PUSH_ENABLED=false
OPS_PUBLIC_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
