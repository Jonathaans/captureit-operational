# Example only: NOT validated with nginx -t in this QA environment.
# Include in the nginx http context (e.g. conf.d on a standard installation).
# Replace domain and certificate paths; never expose the app's port 8000 publicly.
# This proxy does not make Python http.server a production-grade app server.
limit_req_zone $binary_remote_addr zone=captureit_login:10m rate=5r/m;

server {
    listen 80;
    server_name ops.example.com;
    return 308 https://ops.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name ops.example.com;
    ssl_certificate /etc/letsencrypt/live/ops.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ops.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 15m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Tune with real shared-office/mobile IP usage; limits are per source IP.
    # If behind a CDN, configure only its explicitly trusted real-IP ranges first.
    location = /api/login {
        limit_req zone=captureit_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.0;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.0;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_request_buffering on;
    }
}
