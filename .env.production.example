# VPS only. Copy to .env only for a NEW installation; preserve existing credentials.
# HTTPS reverse proxy must be ready before signing in with COOKIE_SECURE=1.
DEMO_MODE=false
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=8000
PUBLIC_PORT=8000
# Docker Compose overrides HOST/PORT/OPS_DB_PATH; do not override private storage paths.
# For non-Docker production.py behind Nginx, set OPS_TRUSTED_PROXY to its exact peer IP.
# Docker sets this internally; its published port must remain loopback-only.
OPS_DB_PATH=./ops.sqlite3
BOOTSTRAP_ADMIN_NAME=Capture It Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Fill a unique admin email and a strong password (12–1024 characters) for the first run.
# Remove BOOTSTRAP_ADMIN_PASSWORD after account creation and recreate the container.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Enable only after a successful manual sync with the intended calendar.
GOOGLE_SYNC_INTERVAL_HOURS=0

# Optional push. Never paste a service-account private key into the web app.
PUSH_ENABLED=false
OPS_PUBLIC_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_FILE=
# For deploy/docker-compose.push.yml only: absolute path on the VPS to the private JSON file.
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
